diff --git a/modules/scarlet-execution/src/main/scala/com/ewoodbury/scarlet/execution/GroupedSumShape.scala b/modules/scarlet-execution/src/main/scala/com/ewoodbury/scarlet/execution/GroupedSumShape.scala
