+      values: Iterable[String],
+  ): ColumnBatch =
+    val column = asUtf8(columnAt(batch, ordinal), ordinal)
+    val codes = values.iterator.map(column.codeOf).filter(_ >= 0).toSet
+    filterUtf8ByCodes(batch, ordinal, codes)
