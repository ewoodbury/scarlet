+    val keyValues = keys.values
+    val valueValues = values.values
+    val rows = keys.length
+    var row = 0
+    while (row < rows) {
+      applySteps(keyValues(row), valueValues(row), steps, slot)
+      if (slot.kept) then table.addSum(slot.key, slot.value.toLong)
+      row += 1
+    }
