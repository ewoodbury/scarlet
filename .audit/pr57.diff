+    val batch = BatchCodec.intPairs(rows)
+    val steps = Vector(PairStep.MapPair((key, value) => (key + 10, value)))
+    val direct = HashAggregate.sumInt32(batch, 0, 1, steps)
+    val partial = onePartial(batch, parallelism = 1, steps)
