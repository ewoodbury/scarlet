+    val rows = Seq((5, 1), (1, 2), (3, 4))
+    val batch = Vector(BatchCodec.intPairs(rows))
+    val kept = ColumnPipeline.sumByKey(
+      batch,
+      keyOrdinal = 0,
+      valueOrdinal = 1,
+      numPartitions = 1,
+      parallelism = 1,
+      batchSize = 8,
+      Vector(PairStep.KeepValue((_: Int) => true)),
+    )
+    val mapped = ColumnPipeline.sumByKey(
+      batch,
+      keyOrdinal = 0,
+      valueOrdinal = 1,
